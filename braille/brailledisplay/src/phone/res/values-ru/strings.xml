  <string name="bd_braille_elements_gra">• gra обозначает графический элемент.</string>
  <string name="bd_braille_elements_hdg">• hdg обозначает заголовок.</string>
  <string name="bd_braille_elements_h1_to_h6">• h%1$s – h%2$s обозначают заголовки с %1$s по %2$s.</string>
